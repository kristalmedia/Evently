# ─── Test-environment login (seeded users, no password) ───────────────────
# When set to "1", the /login page shows a "Test environment" panel and the
# top bar shows a "Switch user" dev shortcut, backed by /api/auth/login and
# /api/dev/seed-users. Anyone reaching /login can then sign in as any
# seeded user without Microsoft Entra ID. LEAVE UNSET (or set to anything
# other than "1") IN REAL PRODUCTION — the API routes also refuse when
# the flag is off, so hiding the UI is backed by a real server-side gate.
NEXT_PUBLIC_ENABLE_TEST_LOGIN=1

# ─── Session (Better Auth) ──────────────────────────────────────────────────
BETTER_AUTH_URL=http://localhost:3000
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=change-me-in-production

# ─── Microsoft Entra ID (Azure AD) SSO ─────────────────────────────────────
# From: Azure Portal → Microsoft Entra ID → App registrations → New registration.
#   - Redirect URI (Web): <BETTER_AUTH_URL>/api/auth/callback/microsoft
#   - Client ID / Tenant ID: shown on the app's Overview page (not secret).
#   - Client secret: Certificates & secrets → New client secret → copy the
#     "Value" column immediately (Azure only shows it once). This IS secret.
AZURE_AD_CLIENT_ID=
AZURE_AD_TENANT_ID=
AZURE_AD_CLIENT_SECRET=

# ─── Email transport ───────────────────────────────────────────────────────
# Two supported transports — set ONE. Graph is preferred (no plaintext
# mailbox password, scoped credential, centrally rotatable).

# --- Option A: Microsoft Graph via Entra ID app (recommended) ---
# Setup:
#   1. Azure Portal → Entra ID → App registrations → New registration
#      (or reuse the SSO app registration above — the same app can hold
#      both delegated User.Read for SSO and application Mail.Send).
#   2. API permissions → Add → Microsoft Graph → Application permissions
#      → check "Mail.Send" → Add. Then click "Grant admin consent for
#      <tenant>" — required, application permissions don't work without it.
#   3. Certificates & secrets → New client secret → copy the "Value"
#      column immediately (Azure only shows it once). This IS secret.
#   4. Pick a sender mailbox — MSGRAPH_SENDER_UPN must be a licensed
#      Exchange Online mailbox in the same tenant (e.g. a shared
#      "noreply@kristal.media" mailbox). Graph refuses to send from a
#      mailbox that isn't provisioned.
MSGRAPH_TENANT_ID=
MSGRAPH_CLIENT_ID=
MSGRAPH_CLIENT_SECRET=
MSGRAPH_SENDER_UPN=

# --- Option B: SMTP fallback ---
# Only used if any MSGRAPH_ var above is blank. Uses nodemailer against
# any SMTP relay (Office 365, SendGrid, an internal Postfix). Requires a
# plaintext username + password / app-password / API key — that's why
# Graph is preferred.
#
# Example: Office 365 / Exchange
#   EMAIL_SMTP_HOST=smtp.office365.com
#   EMAIL_SMTP_PORT=587
#   EMAIL_SMTP_SECURE=false
#   EMAIL_SMTP_USER=noreply@kristal.media
#   EMAIL_SMTP_PASS=(app password)
#   EMAIL_FROM=noreply@kristal.media
#
# Example: SendGrid
#   EMAIL_SMTP_HOST=smtp.sendgrid.net
#   EMAIL_SMTP_PORT=587
#   EMAIL_SMTP_USER=apikey
#   EMAIL_SMTP_PASS=SG.xxxxxxxxxxxxxxxxxxxxx
#   EMAIL_FROM=noreply@kristal.media   (must be a verified sender)
#
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_SECURE=false
EMAIL_SMTP_USER=
EMAIL_SMTP_PASS=
EMAIL_FROM=

# ─── Google Sheets integration — Sales KOTG bookings ───────────────────────
# Read-only live sync from the Sales team's ServiceBookings/Clients Sheet.
# Setup: Google Cloud Console → create project → enable "Google Sheets API"
# → IAM & Admin → Service Accounts → create one → Keys tab → Add Key (JSON).
# Then open the Sheet → Share → paste the service account's client_email as
# a Viewer. Never commit this file or paste the private key anywhere outside
# .env.local — GOOGLE_SHEETS_PRIVATE_KEY IS secret.
GOOGLE_SHEETS_CLIENT_EMAIL=
# Keep the \n sequences literal (don't turn them into real newlines) and
# keep the whole value wrapped in double quotes.
GOOGLE_SHEETS_PRIVATE_KEY=""
# The long ID in the Sheet's URL: .../spreadsheets/d/<THIS_PART>/edit
GOOGLE_SHEETS_SPREADSHEET_ID=
