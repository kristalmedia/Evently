# ─── Session (mock) ────────────────────────────────────────────────────────
# Not used in mock scaffold — placeholder for real Entra ID / next-auth wiring.
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-me-in-production

# ─── Email transport (spec §3) ─────────────────────────────────────────────
# Fill these in to actually deliver invitation emails. If any is missing,
# the UI honestly reports the send as "simulated" and shows the invitation
# URL as a manual fallback rather than lying.
#
# Example: Office 365 / Exchange
#   EMAIL_SMTP_HOST=smtp.office365.com
#   EMAIL_SMTP_PORT=587
#   EMAIL_SMTP_SECURE=false
#   EMAIL_SMTP_USER=noreply@kristal.media
#   EMAIL_SMTP_PASS=(app password or OAuth secret)
#   EMAIL_FROM=noreply@kristal.media
#
# Example: SendGrid
#   EMAIL_SMTP_HOST=smtp.sendgrid.net
#   EMAIL_SMTP_PORT=587
#   EMAIL_SMTP_USER=apikey
#   EMAIL_SMTP_PASS=SG.xxxxxxxxxxxxxxxxxxxxx
#   EMAIL_FROM=noreply@kristal.media   (must be a verified sender)
#
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_SECURE=false
EMAIL_SMTP_USER=
EMAIL_SMTP_PASS=
EMAIL_FROM=
