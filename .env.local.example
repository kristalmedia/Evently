# ─── Session (Better Auth) ──────────────────────────────────────────────────
BETTER_AUTH_URL=http://localhost:3000
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=change-me-in-production

# ─── Microsoft Entra ID (Azure AD) SSO ─────────────────────────────────────
# From: Azure Portal → Microsoft Entra ID → App registrations → New registration.
#   - Redirect URI (Web): <BETTER_AUTH_URL>/api/auth/callback/microsoft
#   - Client ID / Tenant ID: shown on the app's Overview page (not secret).
#   - Client secret: Certificates & secrets → New client secret → copy the
#     "Value" column immediately (Azure only shows it once). This IS secret.
AZURE_AD_CLIENT_ID=
AZURE_AD_TENANT_ID=
AZURE_AD_CLIENT_SECRET=

# ─── Email transport (spec §3) ─────────────────────────────────────────────
# Fill these in to actually deliver invitation emails. If any is missing,
# the UI honestly reports the send as "simulated" and shows the invitation
# URL as a manual fallback rather than lying.
#
# Example: Office 365 / Exchange
#   EMAIL_SMTP_HOST=smtp.office365.com
#   EMAIL_SMTP_PORT=587
#   EMAIL_SMTP_SECURE=false
#   EMAIL_SMTP_USER=noreply@kristal.media
#   EMAIL_SMTP_PASS=(app password or OAuth secret)
#   EMAIL_FROM=noreply@kristal.media
#
# Example: SendGrid
#   EMAIL_SMTP_HOST=smtp.sendgrid.net
#   EMAIL_SMTP_PORT=587
#   EMAIL_SMTP_USER=apikey
#   EMAIL_SMTP_PASS=SG.xxxxxxxxxxxxxxxxxxxxx
#   EMAIL_FROM=noreply@kristal.media   (must be a verified sender)
#
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_SECURE=false
EMAIL_SMTP_USER=
EMAIL_SMTP_PASS=
EMAIL_FROM=
